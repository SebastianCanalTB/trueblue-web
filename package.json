{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx nuxi build",
    "dev:local": "npx nuxi dev --host --dotenv ./environments/.env.local",
    "dev:development": "npx nuxi dev --host --dotenv ./environments/.env.development",
    "dev:staging": "npx nuxi dev --host --dotenv ./environments/.env.staging",
    "dev:production": "npx nuxi dev --host --dotenv ./environments/.env.production",
    "generate:local": "npx nuxi generate --dotenv ./environments/.env.local",
    "generate:development": "npx nuxi generate --dotenv ./environments/.env.development",
    "generate:staging": "npx nuxi generate --dotenv ./environments/.env.staging",
    "generate:production": "npx nuxi generate --dotenv ./environments/.env.production",
    "preview": "npx nuxi preview",
    "postinstall": "npx nuxi prepare",
    "lint:js": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lintfix": "prettier --write --list-different . && npm run lint:js --fix"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "^0.5.7",
    "@nuxt/image": "^1.9.0",
    "@nuxtjs/i18n": "^8.5.5",
    "@nuxtjs/tailwindcss": "^6.11.4",
    "@primevue/nuxt-module": "^4.3.5",
    "@types/crypto-js": "^4.2.2",
    "@types/luxon": "^3.4.2",
    "nuxt": "^3.13.2",
    "nuxt-zod-i18n": "^1.10.0",
    "prettier": "^3.3.3",
    "sass": "^1.79.4",
    "typescript": "^5.6.2",
    "vue": "^3.5.10",
    "vue-router": "^4.4.5",
    "vue3-carousel-nuxt": "^1.1.1"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@pinia/nuxt": "^0.5.5",
    "@primevue/forms": "^4.3.5",
    "@primevue/themes": "^4.3.5",
    "@vee-validate/zod": "^4.13.2",
    "crypto-js": "^4.2.0",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "perfect-debounce": "^1.0.0",
    "pinia": "^2.2.4",
    "pinia-plugin-persistedstate": "^4.0.2",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.5",
    "uuid": "^11.1.0",
    "vee-validate": "^4.13.2",
    "vue3-lottie": "^3.3.1",
    "vue3-otp-input": "^0.5.21"
  }
}
